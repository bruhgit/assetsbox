{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assetsbox",
  "version": "1.1.0",
  "identifier": "com.omerdev.assetsbox",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Assetsbox",
        "width": 1280,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false,
        "backgroundColor": "#1e1f22"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../src/extensions"],
    "icon": ["../src/assets/build/icon.ico"]
  }
}
